---
// The real Anzu window, compiled from crates/anzu-web, inside a Windows 11 frame. The
// frame is the only HTML here; everything inside the window is the app drawing itself.
// src/scripts/demo.ts starts the window.
import Mark from "./Mark.astro";
import type { Strings } from "../i18n/strings";
interface Props {
  t: Strings;
}
const { t } = Astro.props;
---

<figure class="stage" data-stage data-lang={t.lang}>
  <div class="window" role="img" aria-label={t.demo.label}>
    <div class="caption">
      <Mark badge size={16} />
      <span class="caption-title">{t.demo.windowTitle}</span>
      <span class="caption-buttons" aria-hidden="true">
        <span><svg width="10" height="10" viewBox="0 0 10 10"><path d="M0 5.5h10" stroke="currentColor"></path></svg></span>
        <span><svg width="10" height="10" viewBox="0 0 10 10"><rect x=".5" y=".5" width="9" height="9" rx="1" fill="none" stroke="currentColor"></rect></svg></span>
        <span><svg width="10" height="10" viewBox="0 0 10 10"><path d="M.5.5l9 9M9.5.5l-9 9" stroke="currentColor"></path></svg></span>
      </span>
    </div>
    <div class="viewport" data-viewport>
      <canvas data-canvas width="1180" height="760" tabindex="-1"></canvas>
      <div class="veil" data-veil>
        <span class="veil-text" data-veil-text>{t.demo.loading}</span>
        <button type="button" class="play" data-play hidden>{t.demo.play}</button>
      </div>
    </div>
    <div class="full-bar">
      <span class="full-title">{t.demo.windowTitle}</span>
      <button type="button" class="close-full" data-close-full>{t.demo.closeFull}</button>
    </div>
  </div>
  <div class="below">
    <figcaption class="note">{t.demo.note}</figcaption>
    <button type="button" class="open-full" data-open-full>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
      {t.demo.fullSize}
    </button>
  </div>
  <template data-failed>{t.demo.failed}</template>
</figure>

<style>
  .stage {
    position: relative;
    margin: 0 auto;
    max-width: 1182px;
  }

  /* The window: a Windows 11 frame around the canvas the app draws on. */
  .window {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--caption);
    box-shadow: var(--window-shadow);
  }
  .caption {
    height: 32px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-left: 0.75rem;
    background: var(--caption);
    color: var(--caption-fg);
    font: 12px "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
  }
  .caption-buttons {
    margin-left: auto;
    display: flex;
    height: 100%;
  }
  .caption-buttons span {
    width: 46px;
    display: grid;
    place-items: center;
  }
  .viewport {
    position: relative;
    aspect-ratio: 1180 / 760;
    overflow: hidden;
    background: var(--bg);
  }
  /* The canvas takes the room there is and the app lays itself out in it, as the window
     does when resized. Below the smallest window size the app scales itself down. */
  .viewport canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s var(--ease-out-expo);
    outline: none;
  }
  .stage[data-ready] .viewport canvas {
    opacity: 1;
  }
  .veil {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 13px;
    transition: opacity 0.6s var(--ease-out-expo);
  }
  .stage[data-ready] .veil {
    opacity: 0;
    pointer-events: none;
  }
  .veil-text::after {
    content: "";
    display: block;
    height: 2px;
    margin-top: 0.75rem;
    background: var(--accent);
    transform-origin: left;
    animation: loading 1.4s var(--ease-in-out-quart) infinite;
  }
  .stage[data-failed] .veil-text::after,
  .stage[data-waiting] .veil-text::after {
    display: none;
  }
  @keyframes loading {
    0% {
      transform: scaleX(0);
    }
    50% {
      transform: scaleX(1);
      transform-origin: left;
    }
    51% {
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }
  .play {
    font: inherit;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: 12px;
    padding: 0.8rem 1.2rem;
    min-height: 44px;
    cursor: pointer;
  }
  .below {
    margin-top: 1rem;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }
  .note {
    font-size: 12px;
    color: var(--muted);
    text-align: center;
  }
  .open-full {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    font: inherit;
    font-size: 13px;
    color: var(--fg);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    cursor: pointer;
  }
  .stage[data-small] .open-full {
    display: inline-flex;
  }
  .full-bar {
    display: none;
  }
  .close-full {
    min-height: 44px;
    padding: 0 1rem;
    font: inherit;
    font-size: 13px;
    color: var(--fg);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    cursor: pointer;
  }

  /* On a small screen the window is scaled as a whole; this shows it at least at the
     smallest size of the real window, to pan around. */
  .stage[data-full] .full-bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 61;
    height: 56px;
    padding: env(safe-area-inset-top) 0.75rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--caption);
    color: var(--caption-fg);
    border-bottom: 1px solid var(--line);
    font-size: 12px;
  }
  .stage[data-full] .viewport {
    position: fixed;
    inset: 56px 0 0 0;
    z-index: 60;
    aspect-ratio: auto;
    overflow: auto;
    overscroll-behavior: contain;
    animation: fade 0.4s var(--ease-out-expo);
  }
  .stage[data-full] .viewport canvas {
    position: relative;
    display: block;
    min-width: 820px;
    min-height: 500px;
  }

  @media (max-width: 560px) {
    .caption-title {
      display: none;
    }
  }
</style>
