---
// The Anzu logo, from the same geometry as the app (crates/anzu/src/ui/mark.rs): a solid
// block that turns into lines of text, on a 64 x 64 grid. The block takes the colour of a
// book with DRM and the lines the colour of a book in EPUB.
interface Props {
  size?: number | string;
  class?: string;
  badge?: boolean;
  label?: string;
}
const { size = 28, class: className = "", badge = false, label } = Astro.props;
// Each line starts under the block, so the two colours meet without a seam.
const FULL = {
  block: "M13 14H28V20A2 2 0 0 0 28 24V30A2 2 0 0 0 28 34V40A2 2 0 0 0 28 44V50H13A7 7 0 0 1 6 43V21A7 7 0 0 1 13 14Z",
  lines: [
    "M26 14H55A3 3 0 0 1 55 20H26Z",
    "M26 24H45A3 3 0 0 1 45 30H26Z",
    "M26 34H51A3 3 0 0 1 51 40H26Z",
    "M26 44H37A3 3 0 0 1 37 50H26Z",
  ],
};
// The small cut, as in the app: three thicker lines for badges of 32 px and below.
const SMALL = {
  block: "M13 14H28V22A3 3 0 0 0 28 28V36A3 3 0 0 0 28 42V50H13A7 7 0 0 1 6 43V21A7 7 0 0 1 13 14Z",
  lines: ["M26 14H54A4 4 0 0 1 54 22H26Z", "M26 28H42A4 4 0 0 1 42 36H26Z", "M26 42H48A4 4 0 0 1 48 50H26Z"],
};
const { block: BLOCK, lines: LINES } = badge && typeof size === "number" && size <= 32 ? SMALL : FULL;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {badge && <rect width="64" height="64" rx="18" fill="var(--shell-chip)" />}
  <g transform={badge ? "translate(10.88 10.88) scale(0.66)" : undefined}>
    {LINES.map((d) => <path class="line" d={d} fill="var(--epub)" />)}
    <path class="block" d={BLOCK} fill="var(--drm)" />
  </g>
</svg>
