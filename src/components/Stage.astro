---
// The real Anzu window, compiled from crates/anzu-web, inside a Windows 11 frame. The
// frame and the strip above it are the only HTML here; everything inside the window is
// the app drawing itself. The strip tells where the books come from and where the EPUB
// goes, and its line passes through the window. src/scripts/demo.ts starts the window
// and moves the strip on the demo's events.
import Mark from "./Mark.astro";
import type { Strings } from "../i18n/strings";
interface Props {
  t: Strings;
}
const { t } = Astro.props;
const book =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v16H6.5A1.5 1.5 0 0 0 5 20.5z"/><path d="M5 20.5V4.5"/></svg>';
const folder =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 6.5h6l2 2h10V19H3z"/></svg>';
const file =
  '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/></svg>';
const lock =
  '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>';
// Each file carries the app's three-stage track: with DRM going in, EPUB coming out.
const track = (stage: 1 | 3) => `<span class="mini mini-${stage}" aria-hidden="true"><b></b><b></b><b></b></span>`;
---

<figure class="stage" data-stage data-phase="idle" data-lang={t.lang}>
  <div class="strip" aria-hidden="true">
    <div class="tile tile-in">
      <span class="tile-head"><Fragment set:html={book} />{t.demo.kindle}</span>
      <span class="bar" title={t.demo.downloading}><i></i></span>
      <span class="chip chip-in" style="--i:0"><Fragment set:html={lock} /><span class="name">B0DEMO0001_EBOK.azw</span><Fragment set:html={track(1)} /></span>
      <span class="chip chip-in" style="--i:1"><Fragment set:html={lock} /><span class="name">B0DEMO0002_EBOK.azw</span><Fragment set:html={track(1)} /></span>
    </div>
    <span class="flow flow-in"><i data-dot="in"></i></span>
    <span class="hub"><i data-dot="down"></i><i data-dot="up"></i></span>
    <span class="flow flow-out"><i data-dot="out"></i></span>
    <div class="tile tile-out">
      <span class="tile-head"><Fragment set:html={folder} />{t.demo.output}</span>
      <span class="chip chip-out kept"><Fragment set:html={file} /><span class="name">Walden.epub</span><Fragment set:html={track(3)} /></span>
      <span class="chip chip-out" data-saved="1"><Fragment set:html={file} /><span class="name">Moby-Dick.epub</span><Fragment set:html={track(3)} /></span>
      <span class="chip chip-out" data-saved="2"><Fragment set:html={file} /><span class="name">Pride and Prejudice.epub</span><Fragment set:html={track(3)} /></span>
    </div>
  </div>

  <div class="window" role="img" aria-label={t.demo.label}>
    <div class="caption">
      <Mark badge size={16} />
      <span class="caption-title">{t.demo.windowTitle}</span>
      <span class="caption-buttons" aria-hidden="true">
        <span><svg width="10" height="10" viewBox="0 0 10 10"><path d="M0 5.5h10" stroke="currentColor"></path></svg></span>
        <span><svg width="10" height="10" viewBox="0 0 10 10"><rect x=".5" y=".5" width="9" height="9" rx="1" fill="none" stroke="currentColor"></rect></svg></span>
        <span><svg width="10" height="10" viewBox="0 0 10 10"><path d="M.5.5l9 9M9.5.5l-9 9" stroke="currentColor"></path></svg></span>
      </span>
    </div>
    <div class="viewport" data-viewport>
      <canvas data-canvas width="1180" height="760" tabindex="-1"></canvas>
      <div class="veil" data-veil>
        <span class="veil-text" data-veil-text>{t.demo.loading}</span>
        <button type="button" class="play" data-play hidden>{t.demo.play}</button>
      </div>
    </div>
    <div class="full-bar">
      <span class="full-title">{t.demo.windowTitle}</span>
      <button type="button" class="close-full" data-close-full>{t.demo.closeFull}</button>
    </div>
  </div>
  <div class="below">
    <figcaption class="note">{t.demo.note}</figcaption>
    <button type="button" class="open-full" data-open-full>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
      {t.demo.fullSize}
    </button>
  </div>
  <template data-failed>{t.demo.failed}</template>
</figure>

<style>
  .stage {
    position: relative;
    margin: 0 auto;
    max-width: 1182px;
  }

  /* The strip: Kindle app → the window → Documents\EPUB, on one line. */
  .strip {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 11px;
  }
  .tile {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex: none;
    height: 2.5rem;
    padding: 0 0.6rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    white-space: nowrap;
    transition: border-color 0.6s var(--ease-out-expo);
  }
  .tile-head {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    color: var(--fg);
  }
  .bar {
    width: 3.5rem;
    height: 3px;
    background: var(--line);
    border-radius: 1px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--fg);
    transform-origin: left;
    transform: scaleX(0);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    max-width: 18rem;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-0.4rem);
    transition:
      opacity 0.6s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo),
      max-width 0.9s var(--ease-in-out-quart);
    transition-delay: calc(var(--i, 0) * 0.18s);
  }
  /* Once the EPUBs come out, the Kindle files have gone through the window: they fold
     away and leave the room to the folder that receives them. */
  .stage.stage[data-phase="saved"] .chip-in {
    max-width: 0;
    opacity: 0;
    transition-delay: 0s;
  }
  .chip-out:not(.kept):not(.on) {
    max-width: 0;
  }
  .chip :global(svg) {
    flex: none;
  }
  .chip-in {
    color: var(--warn);
  }
  .chip-out {
    color: var(--ok);
    font-weight: 700;
  }
  .chip-out.kept {
    color: var(--muted);
    font-weight: 400;
    opacity: 1;
    transform: none;
  }
  .chip-out.on {
    opacity: 1;
    transform: none;
  }
  .name {
    min-width: 0;
  }
  /* The app's track, small: three segments, filled as far as the file has come. */
  .chip :global(.mini) {
    flex: none;
    display: inline-grid;
    grid-template-columns: repeat(3, 8px);
    gap: 2px;
  }
  .chip :global(.mini b) {
    height: 4px;
    border-radius: 1px;
    border: 1px solid var(--line);
  }
  .chip :global(.mini-1 b:first-child) {
    background: var(--warn);
    border-color: var(--warn);
  }
  .chip :global(.mini-3 b) {
    background: var(--ok);
    border-color: var(--ok);
  }

  /* The line: from the Kindle tile into the window's caption, and out again. */
  .flow {
    position: relative;
    flex: 1 1 1rem;
    height: 1px;
    margin: 0 0.5rem;
    background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 10px);
  }
  /* Where the line turns down into the window's caption, and comes back out. */
  .hub {
    position: relative;
    flex: none;
    width: 2.5rem;
    align-self: stretch;
  }
  .hub::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 10px);
  }
  .hub::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    bottom: -0.75rem;
    width: 1px;
    background: repeating-linear-gradient(180deg, var(--line) 0 6px, transparent 6px 10px);
  }
  .flow i,
  .hub i {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
  }
  .flow i {
    top: -2px;
    left: 0;
  }
  .hub i {
    left: calc(50% - 2px);
    top: calc(50% - 2px);
  }
  .hub i[data-dot="up"] {
    background: var(--ok);
  }
  .flow-out i {
    background: var(--ok);
  }

  /* Phases, set by the demo's events. */
  .stage:not([data-phase="idle"]) .bar i {
    transform: scaleX(1);
    transition: transform 1.4s var(--ease-in-out-quart);
  }
  .stage:not([data-phase="idle"]) .chip-in {
    opacity: 1;
    transform: none;
    transition-delay: calc(1.1s + var(--i) * 0.18s);
  }
  .stage[data-phase="download"] .tile-in {
    border-color: var(--accent);
  }
  .stage[data-phase="saved"] .tile-out {
    border-color: var(--ok);
  }

  /* The window: a Windows 11 frame around the canvas the app draws on. */
  .window {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--caption);
    box-shadow: var(--window-shadow);
  }
  .caption {
    height: 32px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-left: 0.75rem;
    background: var(--caption);
    color: var(--caption-fg);
    font: 12px "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
  }
  .caption-buttons {
    margin-left: auto;
    display: flex;
    height: 100%;
  }
  .caption-buttons span {
    width: 46px;
    display: grid;
    place-items: center;
  }
  .viewport {
    position: relative;
    aspect-ratio: 1180 / 760;
    overflow: hidden;
    background: var(--bg);
  }
  /* The canvas takes the room there is and the app lays itself out in it, as the window
     does when resized. Below the smallest window size the app scales itself down. */
  .viewport canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s var(--ease-out-expo);
    outline: none;
  }
  .stage[data-ready] .viewport canvas {
    opacity: 1;
  }
  .veil {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 13px;
    transition: opacity 0.6s var(--ease-out-expo);
  }
  .stage[data-ready] .veil {
    opacity: 0;
    pointer-events: none;
  }
  .veil-text::after {
    content: "";
    display: block;
    height: 2px;
    margin-top: 0.75rem;
    background: var(--accent);
    transform-origin: left;
    animation: loading 1.4s var(--ease-in-out-quart) infinite;
  }
  .stage[data-failed] .veil-text::after,
  .stage[data-waiting] .veil-text::after {
    display: none;
  }
  @keyframes loading {
    0% {
      transform: scaleX(0);
    }
    50% {
      transform: scaleX(1);
      transform-origin: left;
    }
    51% {
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }
  .play {
    font: inherit;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: 12px;
    padding: 0.8rem 1.2rem;
    min-height: 44px;
    cursor: pointer;
  }
  .below {
    margin-top: 1rem;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }
  .note {
    font-size: 12px;
    color: var(--muted);
    text-align: center;
  }
  .open-full {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    font: inherit;
    font-size: 13px;
    color: var(--fg);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    cursor: pointer;
  }
  .stage[data-small] .open-full {
    display: inline-flex;
  }
  .full-bar {
    display: none;
  }
  .close-full {
    min-height: 44px;
    padding: 0 1rem;
    font: inherit;
    font-size: 13px;
    color: var(--fg);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    cursor: pointer;
  }

  /* On a small screen the window is scaled as a whole; this shows it at least at the
     smallest size of the real window, to pan around. */
  .stage[data-full] .full-bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 61;
    height: 56px;
    padding: env(safe-area-inset-top) 0.75rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--caption);
    color: var(--caption-fg);
    border-bottom: 1px solid var(--line);
    font-size: 12px;
  }
  .stage[data-full] .viewport {
    position: fixed;
    inset: 56px 0 0 0;
    z-index: 60;
    aspect-ratio: auto;
    overflow: auto;
    overscroll-behavior: contain;
    animation: fade 0.4s var(--ease-out-expo);
  }
  .stage[data-full] .viewport canvas {
    position: relative;
    display: block;
    min-width: 820px;
    min-height: 500px;
  }

  @media (max-width: 1100px) {
    .strip {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.75rem;
      align-items: stretch;
    }
    .flow,
    .hub {
      display: none;
    }
    .tile {
      flex: initial;
      min-width: 0;
      height: auto;
      min-height: 2.5rem;
      padding: 0.6rem 0.75rem;
      flex-wrap: wrap;
      white-space: normal;
    }
    .tile-head {
      flex-basis: 100%;
    }
    /* A file name stays on one line, cut short if the tile is narrow: a folded chip
       must not wrap its name one letter per line. */
    .chip {
      max-width: 100%;
      white-space: nowrap;
    }
    .name {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
  @media (max-width: 560px) {
    .strip {
      grid-template-columns: minmax(0, 1fr);
    }
    .caption-title {
      display: none;
    }
  }
</style>
