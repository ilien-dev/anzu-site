---
import Stage from "./Stage.astro";
import { LINKS, type Strings } from "../i18n/strings";
interface Props {
  t: Strings;
}
const { t } = Astro.props;
---

<section class="pt-10 pb-24 sm:pt-14 sm:pb-32" aria-labelledby="hero-title">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-8">
    <h1
      id="hero-title"
      class="text-[clamp(2.4rem,5vw,4.25rem)] leading-[1.02] font-bold tracking-[-0.035em] text-balance text-fg"
    >
      <span class="m-unveil inline-block" style="--d:.1s">{t.hero.titleA}</span>{" "}
      <span class="m-unveil inline-block text-accent" style="--d:.22s">{t.hero.titleB}</span>
    </h1>
    <div class="mt-7 grid items-start gap-x-14 gap-y-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
      <p class="m-rise max-w-[66ch] text-[15px] leading-[1.7] text-muted sm:text-base" style="--d:.38s">{t.hero.lead}</p>
      <div>
        <div class="m-rise flex flex-wrap items-center gap-x-6 gap-y-4" style="--d:.5s">
          <a
            href={LINKS.releases}
            class="inline-flex min-h-12 items-center gap-3 rounded-app bg-accent px-5 text-[15px] font-bold text-on-accent no-underline transition-[filter,transform] duration-300 ease-out-expo hover:-translate-y-0.5 hover:brightness-110"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 4v11" /><path d="m7 10 5 5 5-5" /><path d="M5 20h14" />
            </svg>
            {t.downloadLong}
          </a>
          <a href="#how" class="text-[14px] text-fg underline decoration-line transition-colors hover:decoration-accent">{t.hero.secondary}</a>
        </div>
        <p class="m-fade mt-4 text-[12px] text-muted" style="--d:.7s">{t.hero.facts.join(" · ")}</p>
      </div>
    </div>
  </div>
  <!-- The window keeps its real width, 1180 px plus its frame, wherever there is room. -->
  <div class="m-window mx-auto mt-8 max-w-[1214px] px-4 sm:mt-10" style="--d:.55s">
    <Stage t={t} />
  </div>
</section>

<script>
  import "../scripts/demo.ts";
</script>
