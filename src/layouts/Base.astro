---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Mark from "../components/Mark.astro";
import { LINKS, type Strings } from "../i18n/strings";
interface Props {
  t: Strings;
}
const { t } = Astro.props;
const canonical = new URL(t.lang === "en" ? "/" : "/es/", Astro.site);
const ogImage = new URL("/og.png", Astro.site);
// What search engines read about the app. Only facts the README backs: no ratings.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Anzu",
  description: t.description,
  url: canonical.href,
  inLanguage: t.htmlLang,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows 10, Windows 11",
  fileFormat: "application/epub+zip",
  downloadUrl: LINKS.releases,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  image: ogImage.href,
  sameAs: [LINKS.repo],
};
// The questions of the page, word for word, so search engines can match them to queries.
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: t.htmlLang,
  mainEntity: t.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL("/", Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL("/es/", Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceGrotesk-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#15161a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060708" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Anzu" />
    <meta property="og:locale" content={t.lang === "en" ? "en_US" : "es_ES"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-app focus:bg-panel focus:px-3 focus:py-2">{t.skip}</a>
    <Header t={t} />
    <main id="main">
      <slot />
    </main>
    <footer class="bg-shell text-shell-muted">
      <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-x-8 gap-y-4 border-t border-shell-line px-4 py-8 text-[12px] leading-[1.7] sm:px-8">
        <span class="font-display flex items-center gap-2.5 text-[15px] font-bold text-on-shell"><Mark badge size={24} />Anzu</span>
        <span class="max-w-[70ch]">{t.footer.legal} <a class="text-on-shell" href={LINKS.satsuoni}>{t.footer.satsuoni}</a>. {t.footer.trademark}</span>
        <span class="ml-auto flex gap-6">
          <span>{t.footer.license}</span>
          <a class="text-on-shell" href={LINKS.repo}>{t.footer.source}</a>
        </span>
      </div>
    </footer>
  </body>
</html>
