---
import Stage from "./Stage.astro";
import Version from "./Version.astro";
import { LINKS, type Strings } from "../i18n/strings";
interface Props {
  t: Strings;
}
const { t } = Astro.props;

// One tint and one icon per fact, in the order of `t.hero.facts`: system, license, converter, books.
const FACT_TINTS = ["var(--info)", "var(--epub)", "var(--unlocked)", "var(--drm)"];
const FACT_ICONS = [
  '<rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8" /><path d="M12 16v4" />',
  '<path d="m8 8-4 4 4 4" /><path d="m16 8 4 4-4 4" /><path d="m14 5-4 14" />',
  '<path d="M4 9h14" /><path d="m15 5 4 4-4 4" /><path d="M20 15H6" /><path d="m9 11-4 4 4 4" />',
  '<path d="M12 6.5C10.5 5 8 4.5 4 4.5v14c4 0 6.5.5 8 2 1.5-1.5 4-2 8-2v-14c-4 0-6.5.5-8 2z" /><path d="M12 6.5v14" />',
];
---

<section class="pt-10 pb-24 sm:pt-14 sm:pb-32" aria-labelledby="hero-title">
  <div class="mx-auto grid max-w-[1240px] items-center gap-x-14 gap-y-10 px-4 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div>
      <h1
        id="hero-title"
        class="text-[clamp(2.4rem,5vw,4.4rem)] leading-[1.02] font-bold tracking-[-0.05em] text-fg"
      >
        <span class="m-unveil inline-block" style="--d:.1s">{t.hero.titleA}</span><br />
        <span class="m-unveil mt-[0.12em] inline-block rounded-[0.24em] bg-epub px-[0.2em] text-ink" style="--d:.22s">{t.hero.titleB}</span>
      </h1>
      <p class="m-rise mt-7 max-w-[62ch] text-[15px] leading-[1.7] text-muted sm:text-base" style="--d:.38s">{t.hero.lead}</p>
    </div>
    <div>
      <div class="m-rise flex flex-wrap items-center gap-x-4 gap-y-4" style="--d:.5s">
        <a
          href={LINKS.releases}
          class="font-display inline-flex min-h-13 items-center gap-3 rounded-[14px] bg-accent px-6 text-[16px] font-bold text-on-accent no-underline transition-[filter,transform] duration-300 ease-out-expo hover:-translate-y-0.5 hover:brightness-110"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="3" y="3" width="8.4" height="8.4" rx="0.6" /><rect x="12.6" y="3" width="8.4" height="8.4" rx="0.6" /><rect x="3" y="12.6" width="8.4" height="8.4" rx="0.6" /><rect x="12.6" y="12.6" width="8.4" height="8.4" rx="0.6" />
          </svg>
          {t.downloadLong}
        </a>
        <a href="#how" class="inline-flex min-h-13 items-center gap-2 rounded-[14px] border border-line-strong px-5 text-[15px] font-semibold text-fg no-underline transition-colors hover:border-fg">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="m6 13 6 6 6-6" /></svg>
          {t.hero.secondary}
        </a>
      </div>
      <Version t={t} class="m-rise mt-3 text-muted" style="--d:.6s" />
      <dl class="m-fade mt-6 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2" style="--d:.7s">
        {
          t.hero.facts.map((fact, i) => (
            <div class="flex items-center gap-3 bg-panel px-3.5 py-3.5">
              <span class="grid size-8 shrink-0 place-items-center rounded-[10px] text-ink" style={`background:${FACT_TINTS[i % 4]}`} aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={FACT_ICONS[i % 4]} />
              </span>
              <div class="min-w-0">
                <dt class="text-[12px] text-muted">{fact.label}</dt>
                <dd class="m-0 text-[14px] leading-snug font-semibold text-fg">{fact.value}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
  <!-- The window keeps its real width, 1180 px plus its frame, wherever there is room. -->
  <div class="m-window mx-auto mt-8 max-w-[1214px] px-4 sm:mt-10" style="--d:.55s">
    <Stage t={t} />
  </div>
</section>

<script>
  import "../scripts/demo.ts";
</script>
